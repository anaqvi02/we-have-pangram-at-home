    { "type": "text", "id": "title", "x": 100, "y": 16, "width": 700, "height": 30, "text": "We Have Pangram at Home: training pipeline", "fontSize": 24, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "We Have Pangram at Home: training pipeline", "autoResize": true },

